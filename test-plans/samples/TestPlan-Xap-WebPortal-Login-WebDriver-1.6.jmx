                <hashTree/>
                <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler
                        guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui"
                        testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler"
                        testname="Access the login page" enabled="true">
                    <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
                        var ui=JavaImporter(org.openqa.selenium.support.ui);

                        var By = pkg.By;
                        var ExpectedConditions = ui.ExpectedConditions;
                        var WebDriverWait = ui.WebDriverWait;
                        var driver = WDS.browser;

                        var exception = null;
                        var TimeUnit = java.util.concurrent.TimeUnit


                        var wait = new WebDriverWait(driver, ${WAIT_TIME_IN_SECONDS},
                        ${POLLING_INTERVAL_IN_MILLISECONDS})
                        driver.manage().timeouts().pageLoadTimeout(${TIMEOUT_LOGIN_PAGE}, TimeUnit.SECONDS);


                        WDS.log.info(&quot;Test started. Accessing the login page. ${__threadGroupName} User
                        ${__threadNum}&quot;);
                        WDS.sampleResult.sampleStart();
                        driver.get(&apos;${WEBPORTAL_URL}&apos;);
                        WDS.log.info(&quot;Accessed the login page. ${__threadGroupName} User ${__threadNum}&quot;);

                        try {
                        WDS.log.info(&quot;Wait for the username field to be present in the DOM. ${__threadGroupName}
                        User ${__threadNum}&quot;);
                        var isRedirected = wait.until(ExpectedConditions.urlContains(&quot;${REDIRECTED_URL}&quot;));
                        var isVisible = wait.until(ExpectedConditions.visibilityOfElementLocated(pkg.By.id(&apos;txtUserName&apos;)));
                        WDS.sampleResult.sampleEnd();
                        } catch (err) {
                        WDS.log.error(&quot;Login page was not loaded ${__threadGroupName} User ${__threadNum} &quot; +
                        err);
                        WDS.sampleResult.setSuccessful(false);
                        WDS.sampleResult.setResponseMessage(&quot; User name field is not visible. ${__threadGroupName}
                        User ${__threadNum}&quot;);
                        exception = err;
                        } finally {
                        if (exception != null) {
                        throw(exception);
                        }
                        }


                        WDS.sampleResult.sampleEnd();
                    </stringProp>
                    <stringProp name="WebDriverSampler.parameters"></stringProp>
                    <stringProp name="WebDriverSampler.language">javascript</stringProp>
                </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
                <hashTree>
                    <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer"
                               testname="Synchronizing Timer : Access home page" enabled="false">
                        <stringProp name="groupSize">${SIMULTANEOUS_USERS_ACCESS_LOGIN_PAGE}</stringProp>
                        <stringProp name="timeoutInMs">${TIMEOUT_ACCESS_LOGIN_PAGE_IN_MILLISECONDS}</stringProp>
                    </SyncTimer>
                    <hashTree/>
                    <DebugPostProcessor guiclass="TestBeanGUI" testclass="DebugPostProcessor"
                                        testname="Debug PostProcessor" enabled="true">
                        <boolProp name="displayJMeterProperties">false</boolProp>
                        <boolProp name="displayJMeterVariables">true</boolProp>
                        <boolProp name="displaySamplerProperties">false</boolProp>
                        <boolProp name="displaySystemProperties">false</boolProp>
                    </DebugPostProcessor>
                    <hashTree/>
                </hashTree>
                <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler
                        guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui"
                        testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler"
                        testname="Submit login credentials" enabled="true">
                    <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
                        var ui=JavaImporter(org.openqa.selenium.support.ui)
                        var WebDriverWait = ui.WebDriverWait;
                        var By = pkg.By;
                        var driver = WDS.browser;
                        var Thread = java.lang.Thread;

                        var exception = null;
                        var TimeUnit = java.util.concurrent.TimeUnit;
                        var count = 1;

                        var wait = new WebDriverWait(driver, ${WAIT_TIME_IN_SECONDS},
                        ${POLLING_INTERVAL_IN_MILLISECONDS})
                        driver.manage().timeouts().pageLoadTimeout(${TIMEOUT_LANDING_PAGE}, TimeUnit.SECONDS);

                        WDS.sampleResult.sampleStart();
                        WDS.log.info(&quot;Started submitting user credentials for ${__threadGroupName} User
                        ${__threadNum}&quot;);

                        var eleUsername = driver.findElement(By.id(&apos;txtUserName&apos;));
                        eleUsername.click();
                        eleUsername.sendKeys([&apos;${USERNAME}&apos;]);
                        WDS.log.info(&quot;Typed username for ${__threadGroupName} User ${__threadNum}&quot;);

                        var elePassword = driver.findElement(By.id(&apos;txtPassword&apos;));
                        elePassword.click();
                        elePassword.sendKeys([&apos;${PASSWORD}&apos;]);
                        WDS.log.info(&quot;Typed password for user ${__threadGroupName} User ${__threadNum}&quot;);


                        driver.findElement(By.id(&apos;btnLogin&apos;)).click();
                        WDS.log.info(&quot;Clicked login button for ${__threadGroupName} User ${__threadNum}&quot; );


                        WDS.log.info(&quot;Waiting for the redirection for ${__threadGroupName} User ${__threadNum}&quot;
                        );
                        wait.until(ui.ExpectedConditions.urlContains(&quot;${WEBPORTAL_URL}&quot;));
                        WDS.log.info(&quot;Redirection to portal.qa.kidsxap.com.au was checked for ${__threadGroupName}
                        User ${__threadNum}&quot;);

                        WDS.log.info(&quot;Checking the welcome message for ${__threadGroupName} User ${__threadNum}&quot;);
                        var title = wait.until(ui.ExpectedConditions.textToBe(By.cssSelector(&apos;.welcome-text&apos;),
                        &apos;Welcome! ${EXPECTED_TITLE}&apos;));
                        WDS.log.info(&quot;Welcome message is verified for ${__threadGroupName} User ${__threadNum}&quot;);

                        wait.until(ui.ExpectedConditions.frameToBeAvailableAndSwitchToIt(By.cssSelector(&quot;#iframeDashboard&quot;)));

                        driver.switchTo().defaultContent();


                        WDS.log.info(&quot;Start waiting for the popup window for ${__threadGroupName} User
                        ${__threadNum}&quot;);

                        while (!driver.switchTo().frame(&quot;iframeDashboard&quot;).getPageSource().contains(&quot;Please
                        wait while the report is being loaded&quot;)){
                        driver.switchTo().defaultContent();
                        WDS.log.info(&quot;Waiting for popup to appear &quot; + count);
                        Thread.sleep(${POLLING_INTERVAL_IN_MILLISECONDS});
                        if (count++ &gt; WDS.vars.get(&quot;MAX_WAKEUPS&quot;)){
                        break;
                        }
                        }

                        driver.switchTo().defaultContent();
                        count = 0;
                        WDS.log.info(&quot;Start waiting for the popup to dissapear for ${__threadGroupName} User
                        ${__threadNum}&quot; );

                        while (!driver.switchTo().frame(&quot;iframeDashboard&quot;).getPageSource().contains(&quot;z-index:
                        1040; display: none;&quot;)){
                        driver.switchTo().defaultContent();
                        WDS.log.info(&quot;Waiting for popup to disappear &quot; + count);
                        Thread.sleep(${POLLING_INTERVAL_IN_MILLISECONDS});
                        if (count++ &gt; WDS.vars.get(&quot;MAX_WAKEUPS&quot;)){
                        break;
                        }
                        }
                        WDS.log.info(&quot;Iteration completed SUCCESSFULLY for the ${__threadGroupName} User
                        ${__threadNum}&quot;);

                        WDS.sampleResult.sampleEnd();


                    </stringProp>
