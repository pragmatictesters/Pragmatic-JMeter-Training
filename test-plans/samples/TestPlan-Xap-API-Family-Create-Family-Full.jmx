          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor : profilePictureJSON" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String profilePictureName = &quot;cdb81a6f-3edd-496a-ac84-b158278286ec.png&quot;;
                            String profilePictureOriginalName = &quot;Lucretia-Hagenes.png&quot;;


                            String profilePictureJSON = &quot;,\&quot;profilePicture\&quot;:{ \n&quot; +
                            &quot;\&quot;profilePictureName\&quot;:\&quot;&quot; + profilePictureName + &quot;\&quot;,\n&quot;
                            +
                            &quot;\&quot;profilePictureOriginalName\&quot;:\&quot;&quot; + profilePictureOriginalName +&quot;\&quot;\n&quot;
                            +
                            &quot;}&quot;;

                            vars.put(&quot;profilePictureJSON&quot;, profilePictureJSON);


                        </stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
