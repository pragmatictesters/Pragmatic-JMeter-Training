              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor : profilePictureJSON" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">String profilePictureName = &quot;${fileName}&quot;;
                                    String profilePictureOriginalName = &quot;${originalFileName}&quot;;


                                    String profilePictureJSON = &quot;,\&quot;profilePicture\&quot;:{ \n&quot; +
                                    &quot;\&quot;profilePictureName\&quot;:\&quot;&quot; + profilePictureName + &quot;\&quot;,\n&quot;
