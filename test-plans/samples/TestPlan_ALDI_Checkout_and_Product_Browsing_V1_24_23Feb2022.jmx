              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">String requestRelativePath=vars.get(&quot;data-form-url&quot;)
requestRelativePath=requestRelativePath.replaceAll(&quot;/creditCard&quot;, &quot;/creditCard/form&quot;)
requestRelativePath=requestRelativePath.concat(&quot;&amp;brandType=VISA&quot;)
vars.put(&quot;requestRelativePath&quot;,requestRelativePath)
log.info(&quot;requestRelativePath ${requestRelativePath}&quot;)

String referer=vars.get(&quot;data-form-url&quot;).replaceAll(&quot;/creditCard&quot;,&quot;/paymentSelection&quot;)
referer= &quot;https://&quot;.concat(vars.get(&quot;IPG_HOST&quot;)) + referer
vars.put(&quot;referer&quot;,referer)
log.info(&quot;referer  ${referer}&quot;)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
