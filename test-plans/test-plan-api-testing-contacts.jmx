            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String firstName = &quot;${__RandomString(1,ADBCEFEFGHIJ,)}${__RandomString(5,aaabcdefg,)}&quot;;
String lastName = &quot;${__RandomString(1,ADBCEFEFGHIJ,)}${__RandomString(5,aaabcdefghiujklmngodddfss,)}&quot;
String email = firstName + &quot;.&quot; + lastName + &quot;@test.com&quot;

vars.put(&quot;firstName&quot;,firstName);
vars.put(&quot;lastName&quot;,lastName);
vars.put(&quot;email&quot;,email);</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor : Personal Information of new contact">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">//import net.datafaker.Faker;
//
//Faker faker = new Faker();
//
//String firstName = faker.name().firstName(); // Emory
//String lastName = faker.name().lastName(); // Barton
//String email = firstName + &quot;.&quot; + lastName;
//
//vars.put(&quot;firstName&quot;, firstName);
//vars.put(&quot;lastName&quot;, lastName);
//vars.put(&quot;email&quot;, email);

import net.datafaker.Faker;
import java.text.SimpleDateFormat;
import java.util.Locale;
import java.util.concurrent.ThreadLocalRandom;

String jsonEscape(String value) {
    StringBuilder escaped = new StringBuilder();

    for (int i = 0; i &lt; value.length(); i++) {
        char c = value.charAt(i);

        if (c == &apos;&quot;&apos;) {
            escaped.append(&quot;\\\&quot;&quot;);
        } else if (c == &apos;\\&apos;) {
            escaped.append(&quot;\\\\&quot;);
        } else if (c == &apos;\b&apos;) {
            escaped.append(&quot;\\b&quot;);
        } else if (c == &apos;\f&apos;) {
            escaped.append(&quot;\\f&quot;);
        } else if (c == &apos;\n&apos;) {
            escaped.append(&quot;\\n&quot;);
        } else if (c == &apos;\r&apos;) {
            escaped.append(&quot;\\r&quot;);
        } else if (c == &apos;\t&apos;) {
            escaped.append(&quot;\\t&quot;);
        } else if (c &lt; 0x20) {
            escaped.append(String.format(&quot;\\u%04x&quot;, (int) c));
        } else {
            escaped.append(c);
        }
    }

    return escaped.toString();
}

Faker faker = new Faker(Locale.US);

String firstName = faker.name().firstName();
String lastName = faker.name().lastName();
String birthdate = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;)
    .format(faker.date().birthday(18, 65));
String email = faker.internet().emailAddress();
String phone = String.format(
    &quot;%010d&quot;,
    ThreadLocalRandom.current().nextInt(400000000, 424000000)
);

String body =
    &quot;{&quot;
    + &quot;\&quot;firstName\&quot;:\&quot;&quot; + jsonEscape(firstName) + &quot;\&quot;,&quot;
    + &quot;\&quot;lastName\&quot;:\&quot;&quot; + jsonEscape(lastName) + &quot;\&quot;,&quot;
    + &quot;\&quot;birthdate\&quot;:\&quot;&quot; + jsonEscape(birthdate) + &quot;\&quot;,&quot;
    + &quot;\&quot;email\&quot;:\&quot;&quot; + jsonEscape(email) + &quot;\&quot;,&quot;
    + &quot;\&quot;phone\&quot;:\&quot;&quot; + phone + &quot;\&quot;,&quot;
    + &quot;\&quot;street1\&quot;:\&quot;&quot; + jsonEscape(faker.address().streetAddress()) + &quot;\&quot;,&quot;
    + &quot;\&quot;street2\&quot;:\&quot;&quot; + jsonEscape(faker.address().secondaryAddress()) + &quot;\&quot;,&quot;
    + &quot;\&quot;city\&quot;:\&quot;&quot; + jsonEscape(faker.address().city()) + &quot;\&quot;,&quot;
    + &quot;\&quot;stateProvince\&quot;:\&quot;&quot; + jsonEscape(faker.address().stateAbbr()) + &quot;\&quot;,&quot;
    + &quot;\&quot;postalCode\&quot;:\&quot;&quot; + jsonEscape(faker.address().zipCode()) + &quot;\&quot;,&quot;
    + &quot;\&quot;country\&quot;:\&quot;USA\&quot;&quot;
    + &quot;}&quot;;

vars.put(&quot;requestBody&quot;, body);
</stringProp>
          </JSR223PreProcessor>
